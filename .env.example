# DeepSeek API 配置
# 1. 复制本文件并重命名为 .env
# 2. 在 https://platform.deepseek.com/api_keys 创建 API Key 后填入下方
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 可选：自定义接口地址（默认为 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：是否使用系统代理（本机开启 Clash/VPN 导致 SSL 报错时保持 0；
# 需要走代理访问时设为 1）
DEEPSEEK_USE_PROXY=0
